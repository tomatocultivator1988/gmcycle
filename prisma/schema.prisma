generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScheduleType {
  SEMI_MONTHLY
  MONTHLY
}

enum AccountStatus {
  APPLIED
  ACTIVE
  DUE_TODAY
  OVERDUE
  FULLY_PAID
  CLOSED
}

enum PaymentMethod {
  CASH
  GCASH
  BANK
}

enum PaymentType {
  REGULAR
  PARTIAL
  ADVANCE
  FULL
}

enum ItemType {
  GADGET
  CASH
}

enum ScheduleStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

model InstallmentAccount {
  id                 String        @id @default(cuid())
  customerName       String
  customerPhone      String
  customerEmail      String?
  customerAddress    String
  fbLink             String?
  brand              String
  model              String
  unitDescription    String
  itemType           ItemType      @default(GADGET)
  cashPrice          Decimal       @db.Decimal(14, 2)
  installmentPrice   Decimal       @db.Decimal(14, 2)
  downPayment        Decimal       @db.Decimal(14, 2)
  processingFee      Decimal       @default(0.00) @db.Decimal(14, 2)
  remainingBalance   Decimal       @db.Decimal(14, 2)
  term               Int
  monthlyInstallment Decimal       @db.Decimal(14, 2)
  interestRate       Decimal?      @db.Decimal(5, 2)
  status             AccountStatus @default(APPLIED)
  scheduleType       ScheduleType  @default(SEMI_MONTHLY)
  dueDays            Int[]         @default([15, 30])
  firstDueDate       DateTime?
  dateGiven          DateTime?
  startDate          DateTime
  nextDueDate        DateTime
  badRecord          Boolean       @default(false)
  badRecordRemark    String?
  deviceEmail        String?
  deviceEmailPassword String?
  deviceAccountHolderEmail String?
  remarks            String?
  customFields       Json?         @default("{}")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payments  Payment[]
  schedule  InstallmentSchedule[]
  penalties PenaltyRecord[]

  @@index([customerName])
  @@index([status])
  @@index([nextDueDate])
}

model InstallmentSchedule {
  id                   String        @id @default(cuid())
  installmentAccountId String
  periodNumber         Int
  dueDate              DateTime
  amount               Decimal       @db.Decimal(14, 2)
  status               ScheduleStatus @default(PENDING)
  paidDate             DateTime?
  paymentId            String?
  paidAmount           Decimal?      @db.Decimal(14, 2)
  penaltyAmount        Decimal       @default(0.00) @db.Decimal(14, 2)

  installmentAccount InstallmentAccount @relation(fields: [installmentAccountId], references: [id])
  penaltyRecords     PenaltyRecord[]

  @@index([installmentAccountId])
  @@index([dueDate])
  @@index([status])
  @@index([paymentId])
  @@unique([installmentAccountId, periodNumber])
}

model Payment {
  id                   String        @id @default(cuid())
  installmentAccountId String
  customerName         String
  totalAmount          Decimal       @db.Decimal(14, 2)
  paymentDate          DateTime
  method               PaymentMethod
  paymentType          PaymentType
  penaltyAmount        Decimal       @default(0.00) @db.Decimal(14, 2)
  penaltyBreakdown     Json?
  principalBreakdown   Json?
  notes                String?
  cashier              String?
  proofUrl             String?
  voided               Boolean       @default(false)
  voidedAt             DateTime?
  voidReason           String?
  createdAt            DateTime      @default(now())

  installmentAccount InstallmentAccount  @relation(fields: [installmentAccountId], references: [id])
  penalties          PenaltyRecord[]

  @@index([installmentAccountId])
  @@index([paymentDate])
  @@index([installmentAccountId, voided])
  @@index([voided, paymentDate])
}

model PenaltyRecord {
  id                   String              @id @default(cuid())
  installmentAccountId String
  installmentScheduleId String?
  paymentId            String?
  amount               Decimal             @db.Decimal(14, 2)
  appliedDate          DateTime            @default(now())
  reason               String?

  installmentAccount InstallmentAccount   @relation(fields: [installmentAccountId], references: [id])
  installmentSchedule InstallmentSchedule? @relation(fields: [installmentScheduleId], references: [id])
  payment            Payment?             @relation(fields: [paymentId], references: [id])

  @@index([installmentAccountId])
  @@index([installmentScheduleId])
  @@index([appliedDate])
  @@index([paymentId])
}

model AdminConfig {
  id             String         @id @default(cuid())
  penaltyPerDay  Decimal        @default(50.00) @db.Decimal(14, 2)
  roundStep      Int            @default(50)
  adminEmail     String?
  adminPassword  String?
  updatedAt      DateTime       @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  accountId   String
  action      String
  details     String?
  performedBy String?
  paymentId   String?
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@index([createdAt])
}
